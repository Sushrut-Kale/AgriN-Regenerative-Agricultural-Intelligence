# AgriN — Regenerative Agricultural Intelligence
# Environment Configuration Example
# Copy this file to .env and configure local or production variables
# NEVER commit production secrets or credentials to version control

# ── Application Configuration ────────────────────────────────────────────────
APP_NAME=AgriN — Regenerative Agricultural Intelligence
APP_VERSION=2.0.0
TRACK=BRICS Track 4 — AgriN & Regenerative Agricultural Intelligence
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Backend Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS Settings ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./farmfriend.db

# ── ML Model & Knowledge Base ────────────────────────────────────────────────
MODEL_PATH=./models/crop_model_v1.joblib
SCALER_PATH=./models/scaler_v1.joblib
ENCODER_PATH=./models/label_encoder_v1.joblib
MODEL_VERSION=random_forest_v1
KNOWLEDGE_PATH=./knowledge
DATA_PATH=./data

# ── Scientific Honesty & Demonstration Mode ─────────────────────────────────
# When AGRIN_DEMO_MODE=false, unconfigured external providers return NOT_CONNECTED
# or MODEL_NOT_DEPLOYED. When true, explicit demo mocks are enabled with is_synthetic: true.
AGRIN_DEMO_MODE=false

# ── Weather Integration ──────────────────────────────────────────────────────
# Default is Open-Meteo free public tier for global non-commercial research
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# ── Earth Observation Satellite Providers (Optional Live Credentials) ────────
# Sentinel-2 / ESA Copernicus OAuth credentials
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_INSTANCE_ID=

# Landsat / USGS EarthExplorer credentials
LANDSAT_API_KEY=

# ── Plant Pathology Vision Triage (Optional Local Neural Weights) ─────────────
# Path to local quantized PyTorch/ONNX MobileNetV3/EfficientNet weights
AGRIN_VISION_MODEL_PATH=
