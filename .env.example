# FarmFriend AI — Environment Variables Example
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

# Application
APP_NAME=FarmFriend AI
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Backend server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./farmfriend.db

# ML Model
MODEL_PATH=./models/crop_model_v1.joblib
SCALER_PATH=./models/scaler_v1.joblib
ENCODER_PATH=./models/label_encoder_v1.joblib
MODEL_VERSION=random_forest_v1

# CORS (frontend URL)
FRONTEND_URL=http://localhost:5173

# Data paths
KNOWLEDGE_PATH=./knowledge
DATA_PATH=./data

# No external LLM API required — explanations are generated from rules
# LLM_API_KEY=  # not used in this build
